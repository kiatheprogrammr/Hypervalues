diff --git a/share.js b/share.js
new file mode 100644
index 0000000..394a98b
--- /dev/null
+++ b/share.js
@@ -0,0 +1,90 @@
+/*
+ * Share links: your answers packed into a short code that fits in a URL hash, and back.
+ *   HVShare.encode(answers) -> "AQ..." (url-safe base64)
+ *   HVShare.decode(code)    -> answers ({ category: [{ value, agree }] }) or null if the code is not valid
+ *   HVShare.link(page, answers) -> absolute link such as ".../shared.html#r=AQ..."
+ *   HVShare.codeFromText(text)  -> the code inside a pasted link or a bare code, or null
+ * Needs data.js and scoring.js (HV.categoryOf) to be loaded first.
+ *
+ * Format: 1 version byte, then 4 bytes per value: a 24-bit hash of the value's id (so the code stays valid when
+ * values are added or reordered in data.js) and the agreement in hundredths + 100 (0..200).
+ * tools/check_share.js fails if two values ever get the same hash.
+ */
+const HVShare = (function () {
+    const VERSION = 1;
+
+    // FNV-1a, cut to 24 bits
+    function hashOf(id) {
+        let h = 0x811c9dc5;
+        for (let i = 0; i < id.length; i++) {
+            h ^= id.charCodeAt(i);
+            h = Math.imul(h, 0x01000193);
+        }
+        return (h >>> 0) & 0xffffff;
+    }
+
+    const byHash = {};
+    Object.keys(HV.categoryOf).forEach(id => {
+        const h = hashOf(id);
+        if (byHash[h] === undefined) byHash[h] = id;
+    });
+
+    function toBase64Url(bytes) {
+        let binary = '';
+        bytes.forEach(b => { binary += String.fromCharCode(b); });
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    function fromBase64Url(text) {
+        const padded = text.replace(/-/g, '+').replace(/_/g, '/');
+        const binary = atob(padded + '='.repeat((4 - padded.length % 4) % 4));
+        return Uint8Array.from(binary, ch => ch.charCodeAt(0));
+    }
+
+    function encode(answers) {
+        const bytes = [VERSION];
+        Object.keys(answers || {}).forEach(category => {
+            (answers[category] || []).forEach(item => {
+                if (!(item.value in HV.categoryOf)) return;
+                const level = Math.max(-1, Math.min(1, Number(item.agree) || 0));
+                const h = hashOf(item.value);
+                bytes.push((h >> 16) & 255, (h >> 8) & 255, h & 255, Math.round(level * 100) + 100);
+            });
+        });
+        return toBase64Url(bytes);
+    }
+
+    function decode(code) {
+        let bytes;
+        try { bytes = fromBase64Url(String(code || '').trim()); } catch (e) { return null; }
+        if (bytes.length < 5 || bytes[0] !== VERSION || (bytes.length - 1) % 4 !== 0) return null;
+        const answers = {};
+        const seen = {};
+        for (let i = 1; i < bytes.length; i += 4) {
+            const h = (bytes[i] << 16) | (bytes[i + 1] << 8) | bytes[i + 2];
+            const raw = bytes[i + 3];
+            const id = byHash[h];
+            if (!id || raw > 200 || seen[id]) continue;          // unknown value (newer or older data) or repeated: skipped
+            seen[id] = true;
+            const category = HV.categoryOf[id];
+            (answers[category] = answers[category] || []).push({ value: id, agree: (raw - 100) / 100 });
+        }
+        return Object.keys(answers).length ? answers : null;
+    }
+
+    function link(page, answers) {
+        const base = location.href.split('#')[0].replace(/[^/]*$/, '');
+        return base + page + '#r=' + encode(answers);
+    }
+
+    // A pasted link (...#r=CODE, ...#a=CODE, ...#b=CODE) or just the code
+    function codeFromText(text) {
+        const value = String(text || '').trim();
+        if (!value) return null;
+        const match = value.match(/[#&?](?:r|a|b)=([A-Za-z0-9_-]+)/);
+        const code = match ? match[1] : value;
+        return /^[A-Za-z0-9_-]+$/.test(code) && decode(code) ? code : null;
+    }
+
+    return { encode, decode, link, codeFromText, hashOf };
+})();
diff --git a/shared.html b/shared.html
new file mode 100644
index 0000000..a323cff
--- /dev/null
+++ b/shared.html
@@ -0,0 +1,104 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Shared result - HyperValues</title>
+    <link rel="stylesheet" href="style.css">
+    <link rel="icon" type="image/svg+xml" href="icon.svg">
+    <script src="theme.js"></script>
+    <script src="linebreak.js"></script>
+</head>
+<body>
+    <div class="main-container">
+        <h1>Shared result</h1>
+        <p id="share-note" class="share-note">Someone shared these values with you. Nothing here is saved in your browser unless you choose to use them as your own.</p>
+        <p id="share-error" class="compare-error" role="alert" style="display: none;"></p>
+
+        <div id="results-panel" class="results-panel"></div>
+        <div id="values-container" class="category-list"></div>
+        <div id="explain-panel" class="ins-section"></div>
+        <div id="radar-panel" class="ins-section"></div>
+        <div id="map-panel" class="ins-section"></div>
+
+        <div class="button-container">
+            <div id="share-actions" class="download-row">
+                <button id="compare-button">Compare with my values</button>
+                <button id="import-button">Use these as my values</button>
+            </div>
+            <button id="copy-button">Copy this link</button>
+            <p id="share-status" class="share-status" role="status" aria-live="polite"></p>
+            <button onclick="location.href='index.html'">Back to menu</button>
+        </div>
+    </div>
+
+    <script src="data.js"></script>
+    <script src="scoring.js"></script>
+    <script src="share.js"></script>
+    <script src="insights.js"></script>
+    <script>
+        const byId = id => document.getElementById(id);
+        const PANELS = ['results-panel', 'values-container', 'explain-panel', 'radar-panel', 'map-panel'];
+
+        function codeFromHash() {
+            const match = location.hash.match(/[#&]r=([A-Za-z0-9_-]+)/);
+            return match ? match[1] : null;
+        }
+
+        function render() {
+            const code = codeFromHash();
+            const shared = code ? HVShare.decode(code) : null;
+            const error = byId('share-error');
+            byId('share-status').textContent = '';
+
+            if (!shared) {
+                error.textContent = code
+                    ? 'This link could not be read. It may be cut off; ask for the link again.'
+                    : 'This page needs a link that carries values. Take the quiz and use "Copy share link" on your results.';
+                error.style.display = '';
+                PANELS.forEach(id => { byId(id).style.display = 'none'; });
+                byId('share-actions').style.display = 'none';
+                byId('copy-button').style.display = 'none';
+                return;
+            }
+            error.style.display = 'none';
+            PANELS.forEach(id => { byId(id).style.display = ''; });
+            byId('share-actions').style.display = '';
+            byId('copy-button').style.display = '';
+
+            const ranked = HVInsights.renderHeadline(byId('results-panel'), shared);
+            HVInsights.renderTiles(byId('values-container'), shared);
+            if (ranked.length) {
+                HVInsights.renderExplainer(byId('explain-panel'), shared, ranked.slice(0, 4), { who: 'they' });
+                HVInsights.renderRadar(byId('radar-panel'), shared, ranked.slice(0, 3), { who: 'they' });
+                HVInsights.renderMap(byId('map-panel'), [{ name: 'Shared', answers: shared }], {
+                    youNote: 'The shared result is placed at the center of its five closest ideologies, weighted by how well each fits. '
+                });
+            } else {
+                ['explain-panel', 'radar-panel', 'map-panel'].forEach(id => { byId(id).style.display = 'none'; });
+            }
+            if (typeof fitNames === 'function') fitNames();
+
+            byId('compare-button').onclick = () => { location.href = 'compare.html#b=' + code; };
+            byId('import-button').onclick = () => {
+                const mine = HV.loadAnswers();
+                const hasValues = categories.some(cat => mine[cat] && mine[cat].length);
+                if (hasValues && !confirm('This replaces the values saved in this browser with the shared ones. Continue?')) return;
+                HV.saveAnswers(shared);
+                location.href = 'results.html';
+            };
+            byId('copy-button').onclick = async () => {
+                try {
+                    await navigator.clipboard.writeText(location.href);
+                    byId('share-status').textContent = 'Link copied.';
+                } catch (e) {
+                    window.prompt('Copy this link:', location.href);
+                }
+            };
+        }
+
+        window.addEventListener('hashchange', render);
+        render();
+    </script>
+</body>
+</html>
