@@ -0,0 +1,31 @@
+name: Checks
+
+# Runs on every push and pull request, so a change uploaded from the browser is checked too
+on:
+  push:
+  pull_request:
+
+jobs:
+  check:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+      - name: Syntax of every script
+        run: |
+          for f in *.js tools/*.js; do
+            node --check "$f" || exit 1
+          done
+      - name: JSON files are valid
+        run: |
+          for f in *.json; do
+            node -e "JSON.parse(require('fs').readFileSync(process.argv[1], 'utf8'))" "$f" || exit 1
+          done
+      - name: Pages point at existing files
+        run: node tools/check_pages.js
+      - name: Data and ranking
+        run: node tools/check_scoring.js
+      - name: Share links and insights
+        run: node tools/check_share.js
