+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Compare - HyperValues</title>
+    <link rel="stylesheet" href="style.css">
+    <link rel="icon" type="image/svg+xml" href="icon.svg">
+    <script src="theme.js"></script>
+    <script src="linebreak.js"></script>
+</head>
+<body>
+    <div class="main-container">
+        <h1>Compare</h1>
+        <p class="share-note">See where two people agree and disagree, by category and by ideology. Paste the share link of the other person; yours is used unless you paste one for the first side too.</p>
+
+        <div class="ins-section" style="margin-top: 20px;">
+            <div class="compare-form">
+                <div class="compare-side">
+                    <label for="name-a">First person</label>
+                    <input id="name-a" type="text" maxlength="24" autocomplete="off">
+                    <label for="code-a">Link or code (optional)</label>
+                    <textarea id="code-a" spellcheck="false" aria-describedby="hint-a"></textarea>
+                    <p id="hint-a" class="compare-hint">Leave empty to use the values saved in this browser.</p>
+                </div>
+                <div class="compare-side">
+                    <label for="name-b">Second person</label>
+                    <input id="name-b" type="text" maxlength="24" autocomplete="off">
+                    <label for="code-b">Link or code</label>
+                    <textarea id="code-b" spellcheck="false" aria-describedby="hint-b"></textarea>
+                    <p id="hint-b" class="compare-hint">Paste the link from "Copy share link" on their results page.</p>
+                </div>
+            </div>
+            <p id="compare-error" class="compare-error" role="alert" style="display: none;"></p>
+            <div class="button-container" style="margin-bottom: 0;">
+                <button id="compare-run">Compare</button>
+            </div>
+        </div>
+
+        <div id="comparison" style="width: 100%; display: flex; flex-direction: column; align-items: center;"></div>
+
+        <div class="button-container">
+            <button id="copy-button" style="display: none;">Copy comparison link</button>
+            <p id="share-status" class="share-status" role="status" aria-live="polite"></p>
+            <button onclick="location.href='results.html'">Back to my results</button>
+            <button onclick="location.href='index.html'">Back to menu</button>
+        </div>
+    </div>
+
+    <script src="data.js"></script>
+    <script src="scoring.js"></script>
+    <script src="share.js"></script>
+    <script src="insights.js"></script>
+    <script>
+        const byId = id => document.getElementById(id);
+        const el = HVInsights.el;
+        const hasValues = answers => categories.some(cat => answers[cat] && answers[cat].length);
+        const percent = x => Math.round(x * 100) + '%';
+        const AGREE_WITHIN = 0.5;       // two answers this close count as agreeing
+
+        let current = null;             // { codeA, codeB, nameA, nameB } of the comparison on screen
+
+        function readHash() {
+            const params = new URLSearchParams(location.hash.slice(1));
+            return { a: params.get('a'), b: params.get('b'), an: params.get('an'), bn: params.get('bn') };
+        }
+
+        function showError(text) {
+            const box = byId('compare-error');
+            box.textContent = text;
+            box.style.display = text ? '' : 'none';
+        }
+
+        // The answers of one side: its pasted link or code, or (first side only) the values saved in this browser
+        function resolveSide(text, isFirst) {
+            const typed = text.trim();
+            if (typed) {
+                const code = HVShare.codeFromText(typed);
+                return code ? { code, answers: HVShare.decode(code), local: false } : { error: 'That link or code could not be read.' };
+            }
+            if (!isFirst) return { error: 'Paste a link or code for the second person.' };
+            const mine = HV.loadAnswers();
+            return hasValues(mine) ? { code: HVShare.encode(mine), answers: mine, local: true } : { error: 'There are no values saved in this browser yet. Take the quiz first, or paste a link for the first person.' };
+        }
+
+        function defaultNames(aLocal) { return aLocal ? ['You', 'Them'] : ['Person A', 'Person B']; }
+
+        function run(options) {
+            const a = resolveSide(byId('code-a').value, true);
+            const b = resolveSide(byId('code-b').value, false);
+            if (a.error || b.error) {
+                showError(a.error ? 'First person: ' + a.error : 'Second person: ' + b.error);
+                byId('comparison').innerHTML = '';
+                byId('copy-button').style.display = 'none';
+                return;
+            }
+            showError('');
+            const [defA, defB] = defaultNames(a.local);
+            const nameA = byId('name-a').value.trim() || defA;
+            const nameB = byId('name-b').value.trim() || defB;
+            current = { codeA: a.code, codeB: b.code, nameA, nameB };
+            // a link that stays the same for whoever opens it
+            if (!options || !options.keepHash) {
+                history.replaceState(null, '', '#' + comparisonHash());
+            }
+            renderComparison(a.answers, b.answers, nameA, nameB);
+            byId('copy-button').style.display = '';
+        }
+
+        function comparisonHash() {
+            return `a=${current.codeA}&b=${current.codeB}&an=${encodeURIComponent(current.nameA)}&bn=${encodeURIComponent(current.nameB)}`;
+        }
+
+        // ------------------------------------------------------------------------------------------
+        function section(title, intro) {
+            const box = el('section', 'ins-section');
+            box.append(el('h2', 'ins-heading', title));
+            if (intro) box.append(el('p', 'ins-intro', intro));
+            return box;
+        }
+
+        function rankList(items, noteOf) {
+            const list = el('ol', 'compare-rank');
+            items.forEach(item => {
+                const li = el('li');
+                const link = el('a');
+                link.href = `description.html?id=${encodeURIComponent(item.label)}&type=ideology`;
+                const dot = el('span', 'compare-dot');
+                dot.style.backgroundColor = HVInsights.colorOf(item.label);
+                const name = el('span', '', item.label);
+                link.append(dot, name, el('span', 'compare-rank-note', noteOf(item)));
+                li.append(link);
+                list.append(li);
+            });
+            return list;
+        }
+
+        function column(title, content) {
+            const box = el('div');
+            box.append(el('h3', 'ins-group-title', title), content);
+            return box;
+        }
+
+        function renderComparison(A, B, nameA, nameB) {
+            const host = byId('comparison');
+            host.innerHTML = '';
+            const result = HVInsights.overlap(A, B);
+            const probA = {}, probB = {};
+            result.rankedA.forEach(item => { probA[item.label] = item.probability; });
+            result.rankedB.forEach(item => { probB[item.label] = item.probability; });
+            const topA = HV.closestIdeologies(A, null, 5);
+            const topB = HV.closestIdeologies(B, null, 5);
+
+            // ---- overall
+            const overall = section('How alike you are');
+            const scores = el('div', 'compare-score-row');
+            const s1 = el('div', 'compare-score');
+            s1.append(el('div', 'compare-score-number', percent(result.ideology)),
+                el('div', 'compare-score-label', 'Ideology overlap: how much of the probability both results put on the same ideologies.'));
+            const s2 = el('div', 'compare-score');
+            s2.append(el('div', 'compare-score-number', result.values === null ? 'None' : percent(result.values)),
+                el('div', 'compare-score-label', result.values === null
+                    ? 'No value was answered by both people, so there is nothing to compare value by value yet.'
+                    : `Value agreement on the ${result.sharedValues} value${result.sharedValues === 1 ? '' : 's'} both answered (100% means identical answers, 0% opposite ones).`));
+            scores.append(s1, s2);
+            overall.append(scores);
+            if (topA[0] && topB[0]) {
+                overall.append(el('p', 'ins-summary', topA[0].label === topB[0].label
+                    ? `Both of you are closest to ${topA[0].label}.`
+                    : `${nameA} is closest to ${topA[0].label}, ${nameB} to ${topB[0].label}.`));
+            }
+            const tops = el('div', 'compare-top');
+            tops.append(
+                column(`${nameA}'s closest ideologies`, rankList(topA, item => HV.percent(item.probability))),
+                column(`${nameB}'s closest ideologies`, rankList(topB, item => HV.percent(item.probability)))
+            );
+            overall.append(tops);
+            host.append(overall);
+
+            // ---- by ideology
+            const labels = HVInsights.labels;
+            const shared = labels.map(label => ({ label, both: Math.sqrt((probA[label] || 0) * (probB[label] || 0)) }))
+                .sort((x, y) => y.both - x.both).slice(0, 5);
+            const gap = labels.map(label => ({ label, diff: (probA[label] || 0) - (probB[label] || 0) }));
+            const moreA = gap.filter(x => x.diff > 0).sort((x, y) => y.diff - x.diff).slice(0, 3);
+            const moreB = gap.filter(x => x.diff < 0).sort((x, y) => x.diff - y.diff).slice(0, 3);
+            const byIdeology = section('By ideology', 'The ideologies that fit both of you, and the ones that fit one of you much better than the other.');
+            byIdeology.append(el('h3', 'ins-group-title', 'Fit both of you'),
+                rankList(shared, item => `${nameA} ${HV.percent(probA[item.label])}, ${nameB} ${HV.percent(probB[item.label])}`));
+            const split = el('div', 'compare-top');
+            const note = item => `${nameA} ${HV.percent(probA[item.label])}, ${nameB} ${HV.percent(probB[item.label])}`;
+            split.append(column(`Fit ${nameA} much more`, rankList(moreA, note)), column(`Fit ${nameB} much more`, rankList(moreB, note)));
+            byIdeology.append(split);
+            host.append(byIdeology);
+
+            // ---- by category
+            const byCategory = section('By category', 'Open a category to see its values. A value counts as agreed when the two answers are within 0.5 of each other.');
+            categories.forEach(cat => {
+                const listA = A[cat] || [], listB = B[cat] || [];
+                if (!listA.length && !listB.length) return;
+                const rows = {};
+                listA.forEach(item => { rows[item.value] = { a: Number(item.agree) || 0, b: null }; });
+                listB.forEach(item => { (rows[item.value] = rows[item.value] || { a: null, b: null }).b = Number(item.agree) || 0; });
+                const agree = [], differ = [], onlyA = [], onlyB = [];
+                let closeness = 0, counted = 0;
+                Object.keys(rows).forEach(value => {
+                    const row = rows[value];
+                    const base = { category: cat, value };
+                    if (row.a !== null && row.b !== null) {
+                        const distance = Math.abs(row.a - row.b);
+                        closeness += 1 - distance / 2;
+                        counted++;
+                        const item = Object.assign(base, { a: row.a, b: row.b, distance, score: 1 - distance });
+                        (distance <= AGREE_WITHIN ? agree : differ).push(item);
+                    } else if (row.a !== null) onlyA.push(Object.assign(base, { a: row.a }));
+                    else onlyB.push(Object.assign(base, { b: row.b }));
+                });
+                agree.sort((x, y) => x.distance - y.distance);
+                differ.sort((x, y) => y.distance - x.distance);
+
+                const details = el('details', 'compare-cat');
+                if (differ.length) details.open = true;
+                const summary = el('summary');
+                summary.append(el('span', 'compare-cat-name', categoryTitles[cat] || cat));
+                const bar = el('div', 'compare-bar');
+                bar.setAttribute('role', 'img');
+                bar.setAttribute('aria-label', counted ? `Agreement ${percent(closeness / counted)}` : 'No value answered by both');
+                const fill = el('span');
+                fill.style.width = counted ? percent(closeness / counted) : '0%';
+                bar.append(fill);
+                summary.append(bar, el('span', 'compare-cat-counts',
+                    `${agree.length} agree, ${differ.length} differ, ${onlyA.length} only ${nameA}, ${onlyB.length} only ${nameB}`));
+                details.append(summary);
+
+                const body = el('div', 'compare-cat-body');
+                const both = r => `${nameA} ${HV.signed(r.a)}, ${nameB} ${HV.signed(r.b)}`;
+                if (agree.length) body.append(HVInsights.chipGroup('Agree', agree, both, '', 6));
+                if (differ.length) body.append(HVInsights.chipGroup('Differ', differ, both, '', 6));
+                if (onlyA.length) body.append(HVInsights.chipGroup(`Only ${nameA}`, onlyA, r => `${nameA} ${HV.signed(r.a)}`, '', 6));
+                if (onlyB.length) body.append(HVInsights.chipGroup(`Only ${nameB}`, onlyB, r => `${nameB} ${HV.signed(r.b)}`, '', 6));
+                details.append(body);
+                byCategory.append(details);
+            });
+            host.append(byCategory);
+
+            // ---- map
+            const mapBox = el('div', 'ins-section');
+            host.append(mapBox);
+            HVInsights.renderMap(mapBox, [{ name: nameA, answers: A }, { name: nameB, answers: B }], {
+                title: 'Where you both sit',
+                intro: 'Every ideology placed by how similar its stances are. The closer the two markers, the more alike the two results. Tap or hover a dot to see its name.'
+            });
+        }
+
+        // ------------------------------------------------------------------------------------------
+        byId('compare-run').onclick = () => run();
+        byId('copy-button').onclick = async () => {
+            const link = location.href.split('#')[0] + '#' + comparisonHash();
+            try {
+                await navigator.clipboard.writeText(link);
+                byId('share-status').textContent = 'Link copied. It opens the same comparison for anyone.';
+            } catch (e) {
+                window.prompt('Copy this link:', link);
+            }
+        };
+
+        // start from the address: #b=CODE compares the saved values with that code, #a=CODE&b=CODE two codes
+        (function start() {
+            const hash = readHash();
+            const aLocal = !hash.a;
+            const [defA, defB] = defaultNames(aLocal);
+            byId('name-a').value = hash.an || defA;
+            byId('name-b').value = hash.bn || defB;
+            byId('name-a').placeholder = defA;
+            byId('name-b').placeholder = defB;
+            if (hash.a) byId('code-a').value = hash.a;
+            if (hash.b) byId('code-b').value = hash.b;
+            if (hash.b) run({ keepHash: true });
+        })();
+    </script>
+</body>
+</html>
