diff --git a/tools/build_matrix.js b/tools/build_matrix.js
new file mode 100644
index 0000000..57b6303
--- /dev/null
+++ b/tools/build_matrix.js
@@ -0,0 +1,58 @@
+// Builds ideology_matrix.js, one score from -1 to +1 for every ideology and every value:  node tools/build_matrix.js
+//   S  stated: the stance listed for the ideology in data.js (+1 strongly supports the value, -1 strongly opposes it)
+//   E  estimated: the ideology lists nothing on the value, so the score is the model's guess from similar
+//      ideologies (scoring.js, guessedValues), kept small (at most +-0.5) because it is a guess, not a position
+//   N  none: no stance and no usable guess, so 0 (neutral, mixed or not clearly defined)
+// A score can be corrected by hand: change it and its letter to M (manual). tools/check_matrix.js leaves M alone.
+// Running this script again rewrites S, E and N entries and keeps every M entry.
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+const root = path.join(__dirname, '..');
+const ctx = { localStorage: { getItem() { return null; }, setItem() {} }, console };
+vm.createContext(ctx);
+['data.js', 'scoring.js'].forEach(f => vm.runInContext(fs.readFileSync(path.join(root, f), 'utf8').replace(/^const /gm, 'var '), ctx, { filename: f }));
+const { HV } = ctx;
+
+const CAP = 0.5;              // largest size of an estimate
+const MIN = 0.05;             // smaller guesses count as "no usable guess"
+const round = x => Math.round(x * 100) / 100;
+const labels = [...new Set(Object.values(ctx.labelMapping))].sort((a, b) => a.localeCompare(b));
+const values = [];
+Object.keys(ctx.resultsMapping).forEach(cat => Object.keys(ctx.resultsMapping[cat]).forEach(v => values.push(v)));
+
+let previous = null;
+const file = path.join(root, 'ideology_matrix.js');
+if (fs.existsSync(file)) {
+    const text = fs.readFileSync(file, 'utf8');
+    previous = JSON.parse(text.slice(text.indexOf('{'), text.lastIndexOf('}') + 1));
+}
+
+const rows = {};
+const stats = { S: 0, E: 0, N: 0, M: 0 };
+labels.forEach(label => {
+    const order = HV.valueOrder(label);
+    const byValue = {};
+    Object.keys(order).forEach(cat => order[cat].forEach(item => { byValue[item.value] = item; }));
+    const old = previous && previous.ideologies[label];
+    const oldIndex = {};
+    if (previous) previous.values.forEach((v, i) => { oldIndex[v] = i; });
+    let scores = [], basis = '';
+    values.forEach(v => {
+        const kept = old && oldIndex[v] !== undefined && old.b[oldIndex[v]] === 'M';
+        if (kept) { scores.push(old.s[oldIndex[v]]); basis += 'M'; stats.M++; return; }
+        const item = byValue[v];
+        if (item && item.listed) { scores.push(round(item.stance)); basis += 'S'; stats.S++; return; }
+        const guess = item ? Math.max(-CAP, Math.min(CAP, round(item.stance))) : 0;
+        if (Math.abs(guess) >= MIN) { scores.push(guess); basis += 'E'; stats.E++; } else { scores.push(0); basis += 'N'; stats.N++; }
+    });
+    rows[label] = { s: scores, b: basis };
+});
+
+const out = '// Generated by tools/build_matrix.js, checked by tools/check_matrix.js. One score from -1 to +1 for every ideology\n' +
+    '// and value (s, in the order of "values"); b says where each score comes from: S stated in data.js, E estimated\n' +
+    '// from similar ideologies, N none (0), M set by hand.\n' +
+    'const IDEOLOGY_MATRIX = ' + JSON.stringify({ values, ideologies: rows }) + ';\n';
+fs.writeFileSync(file, out);
+console.log(`${labels.length} ideologies x ${values.length} values = ${labels.length * values.length} scores; stated ${stats.S}, estimated ${stats.E}, none ${stats.N}, manual ${stats.M}; ${(out.length / 1024).toFixed(0)} KB`);
diff --git a/tools/check_axes.js b/tools/check_axes.js
new file mode 100644
index 0000000..97901ce
--- /dev/null
+++ b/tools/check_axes.js
@@ -0,0 +1,79 @@
+// Checks the custom axes: the position calculation, presets and saved settings:  node tools/check_axes.js
+// Exits with 1 if a check fails.
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+const root = path.join(__dirname, '..');
+const store = {};
+const ctx = { localStorage: { getItem: k => (k in store ? store[k] : null), setItem: (k, v) => { store[k] = String(v); } }, console };
+vm.createContext(ctx);
+['data.js', 'ideology_matrix.js', 'scoring.js', 'insights.js', 'axes.js'].forEach(f => vm.runInContext(fs.readFileSync(path.join(root, f), 'utf8').replace(/^const /gm, 'var '), ctx, { filename: f }));
+const { HV, HVInsights, HVAxes } = ctx;
+
+let failures = 0;
+function check(ok, message) { if (!ok) failures++; console.log((ok ? 'ok    ' : 'FAIL  ') + message); }
+const near = (a, b) => Math.abs(a - b) < 1e-9;
+const ids = HVInsights.valueIds;
+
+// the formula on a small example
+const axis = { label: 'x', low: 'L', high: 'H', weights: { [ids[0]]: 1, [ids[1]]: -0.5, [ids[2]]: 0.5 } };
+const scores = { [ids[0]]: 0.8, [ids[1]]: 0.4, [ids[2]]: -1 };
+const r = HVAxes.position(axis, id => scores[id]);
+check(near(r.num, 0.8 - 0.2 - 0.5) && near(r.den, 2) && near(r.position, 0.05), 'position = sum(weight x score) / sum(|weight|): (0.8 - 0.2 - 0.5) / 2 = 0.05');
+check(near(HVAxes.position({ weights: { [ids[0]]: 1 } }, () => 1).position, 1) && near(HVAxes.position({ weights: { [ids[0]]: -1 } }, () => 1).position, -1), 'a full score on a full weight reaches +1, or -1 for a negative weight');
+check(near(HVAxes.position({ weights: { [ids[0]]: 0.3 } }, () => 1).position, 1), 'scaling every weight by the same amount does not change the position');
+const flipped = HVAxes.position({ weights: { [ids[0]]: -1, [ids[1]]: 0.5, [ids[2]]: -0.5 } }, id => scores[id]);
+check(near(flipped.position, -r.position), 'flipping every weight flips the position');
+
+// answers left out
+const partial = HVAxes.position(axis, id => (id === ids[1] ? null : scores[id]));
+check(near(partial.den, 1.5) && near(partial.num, 0.3) && near(partial.position, 0.2), 'a value that was not answered leaves the sum and the divisor alike');
+check(HVAxes.position(axis, () => null).position === null, 'with no answered value there is no position');
+check(HVAxes.position({ weights: {} }, () => 1).position === null && !HVAxes.isActive({ weights: { [ids[0]]: 0 } }), 'an axis without weights has no position and is not active');
+
+// all positions stay inside -1 to +1 for every ideology
+let inside = true;
+const random = (() => { let s = 99; return () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296); })();
+for (let t = 0; t < 20 && inside; t++) {
+    const weights = {};
+    for (let k = 0; k < 1 + Math.floor(random() * 8); k++) weights[ids[Math.floor(random() * ids.length)]] = Math.round((random() * 2 - 1) * 10) / 10 || 0.1;
+    HVInsights.labels.forEach(label => {
+        const p = HVAxes.position({ weights }, HVAxes.ideologyScore(label)).position;
+        if (p !== null && (p < -1 - 1e-9 || p > 1 + 1e-9)) inside = false;
+    });
+}
+check(inside, 'every ideology gets a position between -1 and +1 on 20 random axes');
+
+// the user's score is the answer, and uses the same function as an ideology would
+const answers = { [HV.categoryOf[ids[3]]]: [{ value: ids[3], agree: -0.6 }] };
+check(HVAxes.userScore(answers)(ids[3]) === -0.6 && HVAxes.userScore(answers)(ids[4]) === null, 'your score for a value is your answer, and null if you did not answer it');
+const lab = HVInsights.labels[0];
